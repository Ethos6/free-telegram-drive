# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Public address of your drive (used in share links)
TGDRIVE_BASE_URL=http://localhost:8080

# Set to 1 when running behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel)
TGDRIVE_TRUST_PROXY=0

# Part size in MiB (16-1900) and parallel uploads (1-8)
TGDRIVE_CHUNK_MB=256
TGDRIVE_PARALLEL=3
